<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f6edde">
  <title>APK Qo‘riqchi</title>
  <style>
    :root{--bg:#f6edde;--paper:#fffcf7;--text:#30251c;--muted:#70665c;--border:#e3d8c8;--green:#008047;--green-dark:#264e35;--pale:#dfece0;--orange:#f5dfbd;--shadow:0 1px 0 rgba(100,65,30,.025)}
    *{box-sizing:border-box}html{background:var(--bg)}body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--text);-webkit-tap-highlight-color:transparent}
    button{font:inherit;cursor:pointer}button:focus-visible,.switch:focus-visible{outline:3px solid #1aa971;outline-offset:3px}
    .app{position:relative;min-height:100dvh;max-width:520px;margin:0 auto;background:var(--bg);padding-bottom:calc(92px + env(safe-area-inset-bottom));overflow:hidden}
    @media(min-width:620px){body{background:#eee7db}.app{box-shadow:0 0 36px #4f45331b;min-height:100dvh}}
    .top{min-height:91px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 15px 15px;border-bottom:1px solid #e5dbcd}
    .brand{display:flex;align-items:center;gap:12px;min-width:0}.logo{width:43px;height:43px;flex:none;border-radius:12px;object-fit:cover}.brand-title{font-size:20px;font-weight:800;letter-spacing:-.9px;line-height:1.14;white-space:nowrap}.brand-caption{font-size:14px;color:var(--muted);margin-top:4px}.status-pill{border:0;border-radius:30px;background:var(--orange);font-size:12px;font-weight:750;color:#754512;padding:11px 12px;white-space:nowrap}.status-pill.on{background:#d5eadc;color:#256345}
    main{padding:16px 15px 28px}.screen[hidden]{display:none!important}.card{background:var(--paper);border:1px solid var(--border);border-radius:22px;box-shadow:var(--shadow)}
    .scanner-card{padding:20px;margin-bottom:15px}.scanner-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:22px}.scanner-top h1{font-size:28px;letter-spacing:-1.3px;line-height:1.2;margin:0;font-weight:840}.scanner-top p{color:var(--muted);margin:9px 0 0;font-size:16px}.scanner-illustration{width:88px;height:91px;flex:none}
    .scan-btn{display:block;width:100%;min-height:45px;border:0;border-radius:14px;font-size:18px;font-weight:800;padding:12px 8px;margin-top:10px;transition:transform .15s,filter .15s}.scan-btn:active{transform:scale(.984)}.scan-btn.primary{background:var(--green);color:white}.scan-btn.secondary{background:var(--pale);color:var(--green-dark)}.scan-btn:hover{filter:brightness(.98)}
    .section-title{font-size:14px;letter-spacing:.7px;font-weight:800;color:#716459;margin:17px 4px 12px}.date{color:var(--muted);font-size:14px;margin:0 4px 12px}.result-banner{display:flex;align-items:center;gap:14px;background:#dfece0;border-radius:16px;padding:17px 18px;margin-bottom:14px}.result-icon{flex:none;color:var(--green-dark)}.result-heading{font-size:16px;font-weight:780;color:var(--green-dark)}.result-description{font-size:13px;color:var(--muted);margin-top:3px;line-height:1.4}.checklist{padding:13px 15px}.check-row{display:flex;align-items:center;gap:12px;min-height:67px}.check-row+.check-row{border-top:1px solid #eee7dd}.check-icon{width:42px;height:42px;border-radius:11px;background:var(--pale);display:flex;align-items:center;justify-content:center;flex:none;color:var(--green)}.check-name{font-size:16px;font-weight:750;line-height:1.2}.check-caption{font-size:13px;color:var(--muted);margin-top:5px}.check-text{flex:1;min-width:0}.safe-tag{background:var(--pale);padding:5px 8px;border-radius:8px;color:var(--green-dark);font-weight:760;font-size:12px;white-space:nowrap}.prototype-footnote{font-size:11px;color:#948577;line-height:1.45;margin:12px 4px 0}
    .home-card{text-align:center;padding:21px 18px 20px}.hero-mascot{width:122px;height:122px;object-fit:cover;border-radius:50%;border:9px solid #f9f4eb;display:block;margin:0 auto 17px}.home-card h1{font-size:26px;line-height:1.15;letter-spacing:-1px;margin:0 0 8px}.home-card p{font-size:15px;color:var(--muted);line-height:1.55;margin:0 0 18px}.home-card .scan-btn{margin-top:9px}.gift{display:flex;align-items:center;justify-content:space-between;gap:10px;border-radius:18px;background:#f7e5cd;padding:16px 18px;margin:15px 0 0;color:#89531c}.gift strong{font-size:18px}.gift small{font-size:13px;display:block;margin-top:3px}.gift svg{flex:none}.stats-card{display:flex;justify-content:space-between;align-items:center;padding:16px;margin:0}.stats-big{font-size:22px;font-weight:800}.stats-small{font-size:13px;color:var(--muted);margin-top:3px}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:17px 14px}.switch-row+.switch-row{border-top:1px solid #eee7dd}.switch-title{font-weight:750;font-size:16px}.switch-subtitle{color:var(--muted);line-height:1.4;font-size:13px;margin-top:5px}.switch{width:49px;height:29px;border:0;border-radius:20px;background:#e4dcd0;padding:3px;flex:none;transition:background .2s}.switch:before{content:"";display:block;width:23px;height:23px;background:white;border-radius:50%;box-shadow:0 1px 3px #0002;transition:transform .2s}.switch[aria-checked="true"]{background:var(--green)}.switch[aria-checked="true"]:before{transform:translateX(20px)}
    .protect-hero{text-align:center;padding:28px 20px 24px}.protect-hero h1{font-size:25px;margin:12px 0 7px}.protect-hero p{font-size:14px;line-height:1.5;color:var(--muted);margin:0}.protect-symbol{width:88px;height:88px;border-radius:25px;background:var(--pale);display:grid;place-items:center;margin:0 auto;color:var(--green)}.settings-card{padding:0 16px}.settings-row{padding:18px 2px;border-bottom:1px solid #eee7dd}.settings-row:last-child{border-bottom:0}.settings-row strong{display:block;font-size:16px}.settings-row span{display:block;font-size:13px;color:var(--muted);margin-top:4px}
    .nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:520px;height:calc(74px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);background:var(--paper);border-top:1px solid #e8dfd4;display:flex;z-index:10;box-shadow:0 -3px 12px #72635508}.nav-button{border:0;background:none;color:#73685c;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:12px;font-weight:750;flex:1;min-width:0}.nav-button svg{width:23px;height:23px}.nav-button.active{color:var(--green)}
    .overlay{position:fixed;inset:0;background:rgba(41,28,20,.88);z-index:30;display:flex;align-items:center;justify-content:center;padding:24px 15px;color:white;text-align:center}.overlay[hidden]{display:none}.overlay-content{width:100%;max-width:420px;display:flex;align-items:center;flex-direction:column}.ring{height:90px;width:90px;border:4px solid rgba(255,255,255,.24);border-right-color:#35ca99;border-bottom-color:#35ca99;border-radius:50%;animation:spin 1s linear infinite;margin-bottom:14px}.overlay h2{font-size:25px;font-weight:800;letter-spacing:-.75px;margin:0 0 8px}.percent{font-size:33px;font-weight:840;margin-bottom:24px}.track{height:8px;border-radius:100px;background:#ffffff4d;width:min(100%,320px);overflow:hidden;margin-bottom:15px}.fill{height:100%;width:0;background:linear-gradient(90deg,#00854a,#35d5a3);border-radius:100px;transition:width .09s linear}.scan-label{font-size:14px;color:#dfede3;margin:3px 0}.file-path{font-size:14px;color:#f5f5f2;min-height:39px;max-width:340px;line-height:1.4;overflow-wrap:anywhere;margin:2px 0 24px}.cancel{border:1px solid rgba(255,255,255,.45);border-radius:12px;color:white;background:transparent;padding:9px 25px;font-weight:700;font-size:14px}.cancel:active{background:#ffffff23}.done-ring{height:90px;width:90px;background:#1c9d71;border-radius:50%;display:grid;place-items:center;margin:0 auto 20px}.done-body{color:#e4e0d8;font-size:14px;line-height:1.55;margin:8px 0 20px;max-width:320px}.done-button{width:100%;max-width:310px;background:var(--green);color:white;padding:13px;border:0;border-radius:13px;font-weight:800;font-size:16px}
    .result-banner.flash{animation:resultPop .6s ease-out}.toast.success{background:#176d45;color:#fff;font-weight:800;font-size:15px;padding:14px 22px;border-radius:14px} @keyframes resultPop{0%{transform:scale(.965);opacity:.6}65%{transform:scale(1.015)}100%{transform:scale(1);opacity:1}}
    .toast{position:fixed;z-index:80;left:50%;bottom:105px;transform:translateX(-50%);width:max-content;max-width:calc(100vw - 30px);border-radius:10px;padding:10px 15px;background:#2f3028;color:white;font-size:13px;box-shadow:0 5px 20px #0002}.toast[hidden]{display:none}
    @keyframes spin{to{transform:rotate(360deg)}}@media(max-width:350px){.brand-title{font-size:17px}.brand-caption{font-size:12px}.top{gap:7px;padding-left:12px;padding-right:12px}.status-pill{font-size:11px;padding:9px}.scanner-top h1{font-size:26px}.scanner-illustration{width:71px}.check-name{font-size:14px}.safe-tag{font-size:11px}.checklist{padding:8px 12px}}
    @media(prefers-reduced-motion:reduce){.ring{animation:none}.scan-btn,.fill,.switch,.switch:before{transition:none}}
  </style>
</head>
<body>
<div class="app">
  <header class="top">
    <div class="brand">
      <img class="logo" src="data:image/png;base64," alt="APK Qo‘riqchi belgisi">
      <div><div class="brand-title">APK Qo‘riqchi</div><div class="brand-caption">Xavfsizlik markazi</div></div>
    </div>
    <button type="button" class="status-pill" id="statusPill">Himoya o‘chiq</button>
  </header>

  <main>
    <section class="screen" data-screen="scan" id="screen-scan">
      <div class="card scanner-card">
        <div class="scanner-top">
          <div><h1>Skaner</h1><p>Fayllar va ilovalarni tekshiring</p></div>
          <svg class="scanner-illustration" viewBox="0 0 110 106" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <path d="M45 8h36l18 18v57H45a6 6 0 0 1-6-6V14a6 6 0 0 1 6-6Z" fill="#fff8ed" stroke="#603a28" stroke-width="3.8" stroke-linejoin="round"/>
            <path d="M81 8v17a4 4 0 0 0 4 4h14Z" fill="#f89b43" stroke="#603a28" stroke-width="3" stroke-linejoin="round"/>
            <path d="m23 67-15 16a6 6 0 0 0 8 8l17-16" fill="#f18a30" stroke="#5e3322" stroke-width="3"/>
            <circle cx="42" cy="48" r="29" fill="#f29138" stroke="#633a27" stroke-width="4"/>
            <circle cx="42" cy="48" r="20" fill="#fff7e9" stroke="#633a27" stroke-width="3"/>
            <path d="M35 49c1-7 6-12 13-13" stroke="#faac54" stroke-width="4" stroke-linecap="round" fill="none"/>
            <path d="M78 64 100 72v18q-11 12-22 15-11-3-22-15V72Z" fill="#79be5c" stroke="#34542b" stroke-width="3" stroke-linejoin="round"/>
            <path d="M78 72 92 77v11q-8 9-14 11Z" fill="#579943" opacity=".9"/>
          </svg>
        </div>
        <button type="button" class="scan-btn primary" data-scan="quick">Tez skanerlash</button>
        <button type="button" class="scan-btn secondary" data-scan="deep">Chuqur skanerlash</button>
        <button type="button" class="scan-btn secondary" data-scan="apk">So‘nggi APK ni tekshirish</button>
      </div>
      <div class="section-title">OXIRGI NATIJA</div>
      <div class="date" id="lastDate">—</div>
      <div class="result-banner" aria-live="polite">
        <svg class="result-icon" width="31" height="31" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
        <div><div class="result-heading" id="lastHeading">Tekshiruvga tayyor</div><div class="result-description" id="lastDescription">Tekshiruvni boshlash uchun tugmani bosing</div></div>
      </div>
      <div class="card checklist">
        <div class="check-row"><div class="check-icon"><svg width="31" height="31" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m3 12 6 6L21 5"/></svg></div><div class="check-text"><div class="check-name">Tizim fayllari</div><div class="check-caption">612 ta</div></div><span class="safe-tag">Tayyor</span></div>
        <div class="check-row"><div class="check-icon"><svg width="31" height="31" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m3 12 6 6L21 5"/></svg></div><div class="check-text"><div class="check-name">O‘rnatilgan ilovalar</div><div class="check-caption">52 ta ilova</div></div><span class="safe-tag">Tayyor</span></div>
        <div class="check-row"><div class="check-icon"><svg width="31" height="31" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m3 12 6 6L21 5"/></svg></div><div class="check-text"><div class="check-name">Yuklamalar papkasi</div><div class="check-caption">APK · 2 MB</div></div><span class="safe-tag">Tayyor</span></div>
      </div>
      <p class="prototype-footnote">Interaktiv prototip: skanerlash jarayoni va natija ko‘rsatiladi. Haqiqiy qurilma fayllari tekshirilmaydi.</p>
    </section>

    <section class="screen" data-screen="home" id="screen-home" hidden>
      <div class="card home-card">
        <img class="hero-mascot" src="data:image/png;base64," alt="Qo‘riqchi rasmi">
        <h1>Himoyani yoqing</h1>
        <p>Ishlayotgan ilovalar va yuklamalarni himoya qiling</p>
        <button type="button" class="scan-btn primary" data-scan="quick">Tez tekshiruv</button>
        <button type="button" class="scan-btn secondary" id="activateProtection">Himoyani faollashtirish</button>
      </div>
      <div class="section-title">OXIRGI TEKSHIRUV</div>
      <div class="card stats-card"><div><div class="stats-big" id="homeDate">—</div><div class="stats-small">Jami tekshiruvlar</div></div><div style="text-align:right"><div class="stats-big" id="scanCount">0</div><div class="stats-small">Yakunlangan ko‘rsatishlar</div></div></div>
      <div class="section-title">REAL VAQT HIMOYASI</div>
      <div class="card">
        <div class="switch-row"><div><div class="switch-title">Real vaqt himoyasi</div><div class="switch-subtitle">Kelajakdagi funksiyaning interfeys ko‘rinishi</div></div><button class="switch" type="button" role="switch" aria-label="Real vaqt himoyasi" aria-checked="false" data-toggle="protection"></button></div>
        <div class="switch-row"><div><div class="switch-title">Ishlayotgan ilovalar nazorati</div><div class="switch-subtitle">Ilovalar nazorati sozlamasi</div></div><button class="switch" type="button" role="switch" aria-label="Ilovalar nazorati" aria-checked="false" data-toggle="monitor"></button></div>
      </div>
    </section>

    <section class="screen" data-screen="protection" id="screen-protection" hidden>
      <div class="card protect-hero"><div class="protect-symbol"><svg width="51" height="51" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg></div><h1 id="protectTitle">Himoya o‘chiq</h1><p>Himoya imkoniyatlari prototipi. Faollashtirish ko‘rinishi sinov uchun mo‘ljallangan.</p><button type="button" class="scan-btn primary" id="protectionMainBtn">Himoyani yoqish</button></div>
      <div class="section-title">HIMOYA SOZLAMALARI</div>
      <div class="card"><div class="switch-row"><div><div class="switch-title">Real vaqt himoyasi</div><div class="switch-subtitle">Sozlama prototipi</div></div><button class="switch" type="button" role="switch" aria-label="Real vaqt himoyasi" aria-checked="false" data-toggle="protection"></button></div><div class="switch-row"><div><div class="switch-title">Yuklamalarni nazorat qilish</div><div class="switch-subtitle">Sozlama prototipi</div></div><button class="switch" type="button" role="switch" aria-label="Yuklamalarni nazorat qilish" aria-checked="false" data-toggle="monitor"></button></div></div>
    </section>

    <section class="screen" data-screen="settings" id="screen-settings" hidden>
      <div class="section-title">SOZLAMALAR</div>
      <div class="card settings-card"><div class="settings-row"><strong>Til</strong><span>O‘zbekcha</span></div><div class="settings-row"><strong>Ilova</strong><span>APK Qo‘riqchi</span></div><div class="settings-row"><strong>Skanerlash</strong><span>Skanerlash interfeysi prototipi</span></div><div class="settings-row"><strong>Maxfiylik</strong><span>Hech qanday fayl yuklanmaydi va o‘qilmaydi</span></div></div>
      <div class="section-title">PROTOTIP HAQIDA</div><div class="card scanner-card"><div style="font-size:15px;color:var(--muted);line-height:1.5">Bu APK Qo‘riqchi ilovasining interaktiv prototipi. Jarayon animatsion bo‘lib, telefon fayllari haqiqatan skanerlanmaydi.</div><button class="scan-btn secondary" type="button" id="resetState">Holatni tiklash</button></div>
    </section>
  </main>

  <nav class="nav" aria-label="Asosiy navigatsiya">
    <button class="nav-button" data-tab="home" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-7v-7h-4v7H3Z" stroke-linejoin="round"/></svg><span>Bosh</span></button>
    <button class="nav-button active" data-tab="scan" type="button" aria-current="page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="10.7" cy="10.7" r="7.3"/><path d="m16 16 5.2 5.2" stroke-linecap="round"/></svg><span>Skan</span></button>
    <button class="nav-button" data-tab="protection" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg><span>Himoya</span></button>
    <button class="nav-button" data-tab="settings" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg><span>Sozlama</span></button>
  </nav>
</div>

<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-label="Skanerlash jarayoni" hidden>
  <div class="overlay-content" id="progressView">
    <div class="ring" aria-hidden="true"></div>
    <h2>Qurilma tekshirilmoqda...</h2>
    <div class="percent" id="percent">0%</div>
    <div class="track" role="progressbar" aria-label="Tekshiruv jarayoni" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="progressTrack"><div class="fill" id="fill"></div></div>
    <div class="scan-label" id="scanLabel">Fayllar skanerlanmoqda</div>
    <div class="file-path" id="fileName">/data/app/base.apk</div>
    
  </div>
</div>
<div class="toast" id="toast" role="status" hidden></div>
<script>
(function(){
  'use strict';
  const $ = id => document.getElementById(id);
  const overlay=$('overlay'), progressView=$('progressView');
  const percent=$('percent'), fill=$('fill'), progressTrack=$('progressTrack'), fileName=$('fileName');
  // These are sample file paths in the interactive prototype, not files read from the device.
  const simulatedFiles=[
    '/data/app/base.apk',
    '/storage/emulated/0/Download/update.apk',
    '/system/app/Settings/Settings.apk',
    '/data/user/0/com.example.app/cache',
    '/storage/emulated/0/Android/data/',
    '/system/framework/framework-res.apk',
    '/storage/emulated/0/Documents/',
    '/data/app/com.android.chrome/base.apk',
    '/system/priv-app/SystemUI/SystemUI.apk',
    '/storage/emulated/0/Download/photo.jpg',
    '/data/app/com.android.vending/base.apk',
    '/storage/emulated/0/Download/archive.zip'
  ];
  const modes={quick:{time:7600,text:'Fayllar skanerlanmoqda'},deep:{time:12600,text:'Chuqur skanerlash davom etmoqda'},apk:{time:5800,text:'APK fayli skanerlanmoqda'}};
  let running=false, rafId=0, completionTimer=0, previousFile=-1, count=0;
  let protection=false, monitor=false, toastTimer=null, lastFinishedAt=null;

  // Always use the visitor's phone/browser local time. Before a scan, display the current time.
  function nowDisplay(date=new Date()){
    const names=['yan','fev','mar','apr','may','iyn','iyl','avg','sen','okt','noy','dek'];
    return String(date.getDate()).padStart(2,'0')+'-'+names[date.getMonth()]+', '+
      String(date.getHours()).padStart(2,'0')+':'+String(date.getMinutes()).padStart(2,'0');
  }
  function updateDisplayedTime(){
    const shown=nowDisplay(lastFinishedAt||new Date());
    $('lastDate').textContent=shown;
    $('homeDate').textContent=shown;
  }
  updateDisplayedTime();
  setInterval(updateDisplayedTime, 1000);
  document.addEventListener('visibilitychange',updateDisplayedTime);
  window.addEventListener('focus',updateDisplayedTime);

  function switchTab(name){
    document.querySelectorAll('.screen').forEach(el=>el.hidden=el.dataset.screen!==name);
    document.querySelectorAll('.nav-button').forEach(el=>{
      const active=el.dataset.tab===name;
      el.classList.toggle('active',active);
      if(active)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current');
    });
    window.scrollTo({top:0,behavior:'instant'});
  }
  document.querySelectorAll('[data-tab]').forEach(btn=>btn.addEventListener('click',()=>{if(!running)switchTab(btn.dataset.tab)}));
  function setRunning(state){running=state;document.body.style.overflow=state?'hidden':''}
  function setPercent(value){
    percent.textContent=value+'%';
    fill.style.width=value+'%';
    progressTrack.setAttribute('aria-valuenow',String(value));
  }
  function startScan(modeName){
    if(running)return;
    const mode=modes[modeName]||modes.quick;
    clearTimeout(completionTimer);
    setRunning(true);
    previousFile=-1;
    overlay.hidden=false;
    progressView.hidden=false;
    $('scanLabel').textContent=mode.text;
    setPercent(0);
    fileName.textContent=simulatedFiles[0];
    const start=performance.now();
    const run=now=>{
      if(!running)return;
      const elapsed=Math.min(1,(now-start)/mode.time);
      const eased=1-Math.pow(1-elapsed,1.16);
      const value=elapsed>=1?100:Math.min(99,Math.floor(eased*100));
      setPercent(value);
      const idx=Math.min(simulatedFiles.length-1,Math.floor(elapsed*simulatedFiles.length));
      if(idx!==previousFile){
        previousFile=idx;
        fileName.textContent=modeName==='apk'
          ? [simulatedFiles[1],simulatedFiles[0],simulatedFiles[7],simulatedFiles[10]][idx%4]
          : simulatedFiles[idx];
      }
      if(elapsed<1){rafId=requestAnimationFrame(run)}
      else{finishScan()}
    };
    rafId=requestAnimationFrame(run);
  }
  function finishScan(){
    cancelAnimationFrame(rafId);
    setPercent(100);
    $('scanLabel').textContent='Tekshiruv yakunlandi';
    // The overlay remains visible at 100% briefly, then disappears automatically.
    completionTimer=setTimeout(()=>{
      lastFinishedAt=new Date();
      count+=1;
      $('scanCount').textContent=count;
      updateDisplayedTime();
      $('lastHeading').textContent='Hammasi joyida!';
      $('lastDescription').textContent='Tekshiruv yakunlandi · Prototip natijasi';
      overlay.hidden=true;
      setRunning(false);
      switchTab('scan');
      const banner=document.querySelector('.result-banner');
      banner.classList.remove('flash');
      void banner.offsetWidth;
      banner.classList.add('flash');
      toast('✓ Hammasi joyida!',true);
    },650);
  }
  document.querySelectorAll('[data-scan]').forEach(btn=>btn.addEventListener('click',()=>startScan(btn.dataset.scan)));
  function toast(message,success=false){
    const el=$('toast');
    el.textContent=message;
    el.classList.toggle('success',success);
    el.hidden=false;
    clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>el.hidden=true,3500);
  }
  function updateSwitches(){
    document.querySelectorAll('[data-toggle="protection"]').forEach(el=>el.setAttribute('aria-checked',String(protection)));
    document.querySelectorAll('[data-toggle="monitor"]').forEach(el=>el.setAttribute('aria-checked',String(monitor)));
    const pill=$('statusPill');
    pill.textContent=protection?'Himoya yoqilgan':'Himoya o‘chiq';
    pill.classList.toggle('on',protection);
    $('protectTitle').textContent=protection?'Himoya yoqilgan':'Himoya o‘chiq';
    $('protectionMainBtn').textContent=protection?'Himoyani o‘chirish':'Himoyani yoqish';
    $('activateProtection').textContent=protection?'Himoya yoqilgan':'Himoyani faollashtirish';
  }
  function toggle(name){
    if(name==='protection')protection=!protection;
    else monitor=!monitor;
    updateSwitches();
    toast('Prototip sozlamasi o‘zgartirildi');
  }
  document.querySelectorAll('[data-toggle]').forEach(btn=>btn.addEventListener('click',()=>toggle(btn.dataset.toggle)));
  $('statusPill').addEventListener('click',()=>switchTab('protection'));
  $('protectionMainBtn').addEventListener('click',()=>toggle('protection'));
  $('activateProtection').addEventListener('click',()=>toggle('protection'));
  $('resetState').addEventListener('click',()=>{
    count=0;protection=false;monitor=false;lastFinishedAt=null;
    $('scanCount').textContent=count;
    $('lastHeading').textContent='Tekshiruvga tayyor';
    $('lastDescription').textContent='Tekshiruvni boshlash uchun tugmani bosing';
    updateDisplayedTime();updateSwitches();toast('Holat tiklandi');
  });
  // Deliberately no cancel, Escape, or backdrop-close while the progress is below 100%.
  updateSwitches();
})();
</script>
</body>
</html>
